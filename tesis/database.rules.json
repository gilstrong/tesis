{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      "precios_app": {
        ".read": true,
        ".write": "auth != null && auth.token.admin === true"
      },
      "precios_booklet": {
        ".read": true,
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "cotizaciones": {
      ".read": true,
      ".write": true,
      ".indexOn": ["tipo", "timestamp"],
      "$cotizacionId": {
        ".validate": "newData.hasChildren(['total', 'fecha']) && newData.child('total').isString()"
      }
    },
    "facturas": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["fecha_facturacion", "ncf", "rnc_cliente"],
      "$facturaId": {
        ".validate": "newData.exists()"
      }
    },
    "secuencias_ncf": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "maestro_contribuyentes": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@servigaco.com'",
      ".indexOn": ["n"]
    },
    "ventas_log": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "diagnostico": {
      ".read": true,
      ".write": false
    },
    "combos": {
      ".read": true,
      ".write": "auth != null"
    },
    "analisis_pdf": {
      ".read": true,
      ".write": true,
      ".indexOn": ["fecha", "timestamp"]
    }
  }
}
